# Copy this file to .env and fill in real values.
# NEVER commit your real .env file.

# --- MySQL database ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=las_lgu2_archives

# --- Google OAuth 2.0 (Sign in with Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL of the application.
# Production: https://las.spvalenzuela.com   Local: http://localhost:8000 (or http://localhost)
APP_URL=http://localhost:8000

# Database port (MySQL/MariaDB)
DB_PORT=3306

# Status assigned to newly auto-registered Google users: active | pending
GOOGLE_NEW_USER_STATUS=active

# --- Pinata Cloud (IPFS) decentralized file storage ---
# Fill in from https://app.pinata.cloud/developers/api-keys (JWT) and
# https://app.pinata.cloud/gateway (dedicated gateway host).
# Leave PINATA_JWT empty to keep storing files locally only.
PINATA_JWT=
PINATA_GATEWAY=

# --- Google Gemini AI (Archive Assistant) ---
# Create an API key at https://aistudio.google.com/apikey
# Leave empty to disable the AI assistant (it returns a clear error message).
GEMINI_API_KEY=
# Optional model override. If unset, the app defaults to gemini-3.5-flash.
GEMINI_MODEL=

# --- MongoDB Atlas ---
# Direct connection string (use mongodb:// seed-list form, NOT SRV, if the server's DNS
# cannot resolve SRV records, e.g. mongodb://user:pass@ac-xxx-shard-00-00.host.mongodb.net:27017,
# ac-xxx-shard-00-01.host.mongodb.net:27017,ac-xxx-shard-00-02.host.mongodb.net:27017/?tls=true&replicaSet=<name>&authSource=admin)
MONGO_CONNECTION_STRING=
# Host of the primary shard (used as a fallback identifier)
MONGO_HOST=
MONGO_DB_NAME=las_archiving
MONGO_COLLECTION=resolutions

# MongoDB Atlas Data API (used automatically when the native mongodb PHP extension is NOT installed).
# Where to find it: Atlas console -> left sidebar "App Services" -> open (or create) an App linked to
# your cluster -> "Data API" tab -> click "Enable Data API" -> copy the base URL that is shown, e.g.
#   https://us-east-1.aws.data.mongodb-api.com/app/<your-app-id>/endpoint/data/v1
MONGO_DATA_API_URL=
# Cluster/data-source name (shown at the top of the Data API setup page; default is Cluster0)
MONGO_DATA_SOURCE=Cluster0
# API key created under: Atlas -> App Services -> your App -> "Data API" -> "Manage API Keys"
MONGO_DATA_API_KEY=
# Set to 1 to force the Data API transport even when the native extension is available (testing only)
MONGO_FORCE_DATA_API=0
