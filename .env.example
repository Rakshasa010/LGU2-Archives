# =============================================================================
# Application environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# MongoDB (used by the Node/Express file API)
MONGO_URI=mongodb://localhost:27017

# MySQL / MariaDB (used by authdatabase.php)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=las_lgu2_archives

# --- Google OAuth 2.0 (Sign in with Google) ---
# Create a project at https://console.cloud.google.com/apis/credentials
# 1. OAuth client ID  ->  Web application
# 2. Authorized JavaScript origins:
#      https://las.spvalenzuela.com   (production)
#      http://localhost:3306          (local development)
# 3. Authorized redirect URIs (only needed for authorization-code flow):
#      https://las.spvalenzuela.com/google_auth.php
#      http://localhost:3306/google_auth.php
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Base URL of the application, used by the frontend to call the auth handler.
# Production: https://las.spvalenzuela.com
# Local:      http://localhost:3306  (or http://localhost/LGU2-Archives/LGU2-Archives)
APP_URL=http://localhost:3306

# Database port (MySQL/MariaDB)
DB_PORT=3306

# Status assigned to newly auto-registered Google users.
# active  -> login immediately (recommended; Google emails are pre-verified)
# pending -> requires admin approval in User Management
GOOGLE_NEW_USER_STATUS=active
