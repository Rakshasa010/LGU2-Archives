# Copy this file to .env and fill in real values.
# NEVER commit your real .env file.

# --- MySQL database ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=las_lgu2_archives

# --- Google OAuth 2.0 (Sign in with Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL of the application.
# Production: https://las.spvalenzuela.com   Local: http://localhost:8000 (or http://localhost)
APP_URL=http://localhost:8000

# Database port (MySQL/MariaDB)
DB_PORT=3306

# Status assigned to newly auto-registered Google users: active | pending
GOOGLE_NEW_USER_STATUS=active

# --- Pinata Cloud (IPFS) decentralized file storage ---
# Fill in from https://app.pinata.cloud/developers/api-keys (JWT) and
# https://app.pinata.cloud/gateway (dedicated gateway host).
# Leave PINATA_JWT empty to keep storing files locally only.
PINATA_JWT=
PINATA_GATEWAY=

# --- Google Gemini AI (Archive Assistant) ---
# Create an API key at https://aistudio.google.com/apikey
# Leave empty to disable the AI assistant (it returns a clear error message).
GEMINI_API_KEY=
